#!/bin/bash
set -euo pipefail

CWD="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
ROOT="$(cd "$CWD"/.. >/dev/null 2>&1 && pwd)"
REPO="jordond/MaterialKolor"
UPSTREAM_REPO="https://github.com/material-foundation/material-color-utilities"
SUBMODULE_PATH="$ROOT/tools/mcu-upstream/src/main"

usage() {
    echo "Usage: $0 [--token <github-token>] [--no-output]"
    echo "  --token: GitHub token for creating issues"
    echo "  --no-output: Do not output to console"
}

show_output=true
github_token=""
while [[ $# -gt 0 ]]; do
    case $1 in
    --token)
        if [[ $# -lt 2 || -z "$2" ]]; then
            usage >&2
            exit 1
        fi
        github_token="$2"
        shift 2
        ;;
    --no-output)
        show_output=false
        shift
        ;;
    *)
        echo "Unknown option: $1" >&2
        usage >&2
        exit 1
        ;;
    esac
done

log() {
    if "$show_output"; then
        printf '%s\n' "$@"
    fi
}

# Java remains the parity reference; Kotlin is the production input. License
# changes outside those trees must also be reviewed before updating the pin.
relevant_files() {
    grep -Ei '^(java|kotlin)/|(^|/)(licen[cs]es?|notices?|copying)(([._-][^/]*)?$|/)' || [[ $? == 1 ]]
}

# Build and publishing scaffolding under upstream's kotlin/ tree gets its own category: it is the
# first visible sign that upstream is preparing first-party Kotlin Multiplatform artifacts, which
# would change what this project needs to port rather than merely what it needs to re-adapt.
kotlin_scaffold_files() {
    grep -Ei '^kotlin/([^/]+/)*(build\.gradle(\.kts)?|settings\.gradle(\.kts)?|pom\.xml|gradle\.properties|[^/]+\.toml)$' || [[ $? == 1 ]]
}

SOURCE_CATEGORY="upstream-source"
SCAFFOLD_CATEGORY="kotlin-build-scaffold"
SCAFFOLD_NOTE="Build or publishing scaffolding changed under upstream's \`kotlin/\` tree, so \
first-party Kotlin Multiplatform publication may be starting. Review whether this project should \
keep adapting upstream sources. Reference: $UPSTREAM_REPO/pull/76."

report_commit() {
    local commit="$1" files_changed="$2" category="$3"
    local short_sha date full_message title issue_title issue_body api_response existing_issue payload response
    local labels scaffold_section issue_number
    short_sha=$(git rev-parse --short "$commit")
    date=$(git show -s --format=%cI "$commit")
    full_message=$(git log -1 --pretty=%B "$commit")
    title=$(git log -1 --pretty=%s "$commit")
    log "----------------------------------------" "Commit: $short_sha" "Date: $date" \
        "Title: $title" "Category: $category" "Commit message:" "$full_message" \
        "Changed files:" "$files_changed"

    labels=$(jq -nc '["upstream"]')
    scaffold_section=""
    if [[ "$category" == "$SCAFFOLD_CATEGORY" ]]; then
        log "Note: $SCAFFOLD_NOTE"
        labels=$(jq -nc --arg category "$SCAFFOLD_CATEGORY" '["upstream", $category]')
        scaffold_section="
### $SCAFFOLD_CATEGORY

$SCAFFOLD_NOTE
"
    fi

    if [[ -z "$github_token" ]]; then
        return
    fi

    issue_title="[Upstream:$short_sha] $title"
    issue_body="## Info

This commit was authored at $date. You can view the commit [here]($UPSTREAM_REPO/commit/$commit).

### Commit message
$full_message

### Changed files
\`\`\`
$files_changed
\`\`\`
$scaffold_section"
    log "Checking for existing issues..."
    api_response=$(curl --fail-with-body --silent --show-error \
        -H "Authorization: token $github_token" \
        "https://api.github.com/repos/$REPO/issues?state=all&labels=upstream&per_page=100")
    existing_issue=$(jq -r --arg title "$issue_title" \
        '.[] | select(.title == $title) | .number' <<< "$api_response")
    if [[ -n "$existing_issue" ]]; then
        log "Issue already exists for commit $short_sha (Issue #$existing_issue)"
        return
    fi

    payload=$(jq -n --arg title "$issue_title" --arg body "$issue_body" --argjson labels "$labels" \
        '{title: $title, body: $body, labels: $labels}')
    log "Creating issue for commit $short_sha"
    # One commit that cannot be filed must not cost the run every later commit, so the failure is
    # reported here and the loop moves on instead of tripping `set -e`.
    if ! response=$(curl --fail-with-body --silent --show-error -X POST \
        -H "Authorization: token $github_token" \
        -H "Accept: application/vnd.github.v3+json" \
        "https://api.github.com/repos/$REPO/issues" -d "$payload"); then
        echo "Could not create an issue for commit $short_sha; continuing with the next commit." >&2
        return
    fi
    if ! issue_number=$(jq -er '.number' <<< "$response"); then
        echo "Issue creation for commit $short_sha returned no issue number; continuing." >&2
        return
    fi
    log "Created issue #$issue_number for commit $short_sha"
}

log "Checking submodule: $SUBMODULE_PATH"
# Without this guard an uninitialised submodule directory lets `cd` succeed and
# every later git command resolves against the parent repository instead, so the
# monitor would report "no relevant changes" forever.
if [[ ! -e "$SUBMODULE_PATH/.git" ]]; then
    echo "Error: submodule not initialised at $SUBMODULE_PATH" >&2
    echo "Run: git submodule update --init --recursive" >&2
    exit 1
fi
cd "$SUBMODULE_PATH"
log "Fetching latest changes from remote..."
if [[ $(git rev-parse --is-shallow-repository) == true ]]; then
    git fetch --quiet origin --prune --unshallow
else
    git fetch --quiet origin --prune
fi

current_commit=$(git rev-parse HEAD)
remote_commit=$(git rev-parse --verify origin/main 2>/dev/null || git rev-parse --verify origin/master)
log "Current commit: $(git rev-parse --short "$current_commit")" \
    "Remote commit: $(git rev-parse --short "$remote_commit")"
commits=$(git log --reverse --pretty=format:"%H" "${current_commit}..${remote_commit}")
if [[ -z "$commits" ]]; then
    log "No new commits found."
    exit 0
fi

commit_count=0
relevant_commits=0
scaffold_commits=0
while IFS= read -r commit; do
    commit_count=$((commit_count + 1))
    changed_files=$(git diff-tree --root --first-parent -m --no-commit-id --name-only -r "$commit")
    files_to_review=$(relevant_files <<< "$changed_files")
    if [[ -n "$files_to_review" ]]; then
        relevant_commits=$((relevant_commits + 1))
        category="$SOURCE_CATEGORY"
        if [[ -n $(kotlin_scaffold_files <<< "$changed_files") ]]; then
            category="$SCAFFOLD_CATEGORY"
            scaffold_commits=$((scaffold_commits + 1))
        fi
        report_commit "$commit" "$files_to_review" "$category"
    else
        log "Skipping $(git rev-parse --short "$commit"): no Java, Kotlin, or license changes."
    fi
done <<< "$commits"
log "Summary: Processed $commit_count commits, $relevant_commits had Java, Kotlin, or license changes"
if ((scaffold_commits > 0)); then
    log "Summary: $scaffold_commits of those changed kotlin/ build scaffolding ($SCAFFOLD_CATEGORY)"
fi
