{
  "$comment": "Sizes are brotli bytes, 1 MB = 1000000 bytes. BUDGET.md says what is measured and how. Raising a number here is a reviewed edit.",
  "compression": {
    "algorithm": "brotli",
    "quality": 11,
    "window": 22
  },
  "skip": [
    "**/*.map",
    "**/*.LICENSE.txt",
    "_headers",
    "robots.txt"
  ],
  "roles": [
    { "name": "skiko", "files": "assets/skiko.*.wasm", "maxBytes": 2650000 },
    { "name": "app wasm", "files": "assets/MaterialKolor-builder-web.*.wasm", "maxBytes": 1300000 },
    { "name": "glue", "files": "assets/builder.*.js", "maxBytes": 150000 },
    { "name": "initial fonts", "files": "composeResources/com.materialkolor.builder.kit.generated.resources/font/*", "maxBytes": 120000 }
  ],
  "firstVisit": {
    "files": [
      "index.html",
      "assets/*",
      "composeResources/com.materialkolor.**"
    ],
    "exclude": [
      "composeResources/**/files/OFL-*.txt"
    ],
    "maxBytes": 4200000
  },
  "growth": {
    "maxPercent": 5,
    "baseline": "budget-baseline.json"
  }
}
