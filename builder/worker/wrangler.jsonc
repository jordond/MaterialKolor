{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "materialkolor-builder",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "assets": {
    // `./gradlew :builder:apps:web:assembleSite` writes it.
    "directory": "../apps/web/build/site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only link previews and the API run code, everything else is served straight from the site.
    "run_worker_first": ["/t/*", "/og/*", "/api/*"]
  },
  // The cache behind /api/versions. Create the namespace with `wrangler kv namespace create VERSIONS`,
  // then uncomment this with its id. Until then the Worker keeps the answer in the Cache API.
  // "kv_namespaces": [{ "binding": "VERSIONS", "id": "<production namespace id>" }],
  "rules": [{ "type": "Data", "globs": ["**/*.bin"], "fallthrough": false }],
  // Production, which builder.yml deploys from a builder/<version> tag.
  "routes": [{ "pattern": "materialkolor.com", "custom_domain": true }],
  "env": {
    "staging": {
      "routes": [{ "pattern": "staging.materialkolor.com", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": true,
      "vars": { "ROBOTS_TAG": "noindex" }
      // Its own namespace, from `wrangler kv namespace create VERSIONS --env staging`.
      // "kv_namespaces": [{ "binding": "VERSIONS", "id": "<staging namespace id>" }]
    }
  }
}
