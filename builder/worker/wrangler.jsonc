{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "materialkolor-builder",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "assets": {
    // `./gradlew :builder:apps:web:assembleSite` writes it.
    "directory": "../apps/web/build/site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only link previews and the API run code, everything else is served straight from the site.
    "run_worker_first": ["/t/*", "/og/*", "/api/*"]
  },
  // The cache behind /api/versions, the `materialkolor-builder-versions` namespace. Staging shares it,
  // since the answer is the same public Maven data on both. Without it the Worker uses the Cache API.
  "kv_namespaces": [{ "binding": "VERSIONS", "id": "d235a08a5a35422db4e6103d387cfa3d" }],
  "rules": [{ "type": "Data", "globs": ["**/*.bin"], "fallthrough": false }],
  // Production, which builder.yml deploys from a builder/<version> tag.
  "routes": [{ "pattern": "materialkolor.com", "custom_domain": true }],
  "env": {
    "staging": {
      "routes": [{ "pattern": "staging.materialkolor.com", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": true,
      "vars": { "ROBOTS_TAG": "noindex" },
      // Bindings are not inherited by an env, so staging names the same namespace again.
      "kv_namespaces": [{ "binding": "VERSIONS", "id": "d235a08a5a35422db4e6103d387cfa3d" }]
    }
  }
}
