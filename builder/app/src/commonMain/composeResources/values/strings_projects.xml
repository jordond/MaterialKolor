<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The projects drawer's title. -->
    <string name="projects_title">Projects</string>
    <!-- The two ways to start a project, from the defaults or as a copy of the open one. -->
    <string name="projects_new">New project</string>
    <string name="projects_new_copy">Copy this one</string>
    <!-- The search field, shown once there are more than eight projects. -->
    <string name="projects_search">Search projects</string>
    <!-- Shown in place of the list when the search matches nothing. -->
    <string name="projects_search_empty">No projects match</string>
    <!-- Shown in place of the list before anything is saved. -->
    <string name="projects_empty">Nothing saved yet</string>
    <!-- The menu on each row, read out with the project's name. -->
    <string name="projects_more">More for %1$s</string>
    <string name="projects_rename">Rename</string>
    <string name="projects_duplicate">Duplicate</string>
    <string name="projects_delete">Delete</string>
    <!-- The inline rename field, and what it says about an empty name. -->
    <string name="projects_name">Project name</string>
    <string name="projects_name_empty">A project needs a name</string>
    <!-- The name a duplicate gets. The argument is the name of the project it copies. -->
    <string name="projects_copy_name">%1$s copy</string>
    <!-- The toast after a delete, with its undo. The argument is the project's name. -->
    <string name="projects_deleted">Deleted %1$s</string>
    <string name="projects_undo">Undo</string>

    <!-- The target badge on each row. -->
    <string name="projects_target_m3">Material 3</string>
    <string name="projects_target_expressive">Expressive</string>
    <string name="projects_target_unstyled">Unstyled</string>
    <string name="projects_target_fluent">Fluent</string>
    <string name="projects_target_custom">Custom</string>

    <!-- When each project was last saved. -->
    <string name="projects_updated_now">Just now</string>
    <plurals name="projects_updated_minutes">
        <item quantity="one">%1$d minute ago</item>
        <item quantity="other">%1$d minutes ago</item>
    </plurals>
    <plurals name="projects_updated_hours">
        <item quantity="one">%1$d hour ago</item>
        <item quantity="other">%1$d hours ago</item>
    </plurals>
    <plurals name="projects_updated_days">
        <item quantity="one">Yesterday</item>
        <item quantity="other">%1$d days ago</item>
    </plurals>
    <plurals name="projects_updated_weeks">
        <item quantity="one">Last week</item>
        <item quantity="other">%1$d weeks ago</item>
    </plurals>
    <plurals name="projects_updated_months">
        <item quantity="one">Last month</item>
        <item quantity="other">%1$d months ago</item>
    </plurals>
    <plurals name="projects_updated_years">
        <item quantity="one">Last year</item>
        <item quantity="other">%1$d years ago</item>
    </plurals>

    <!-- The banner when this browser keeps nothing, private browsing for example. -->
    <string name="projects_storage_unavailable">This browser isn’t keeping anything, so your work won’t be saved here. Share a link to keep it.</string>
    <string name="projects_storage_share">Get a link</string>

    <!-- The banner when another tab saved the open project while this one was editing it. -->
    <string name="projects_conflict">This project changed in another tab</string>
    <string name="projects_conflict_load">Load latest</string>
    <string name="projects_conflict_keep">Keep mine</string>

    <!-- Toasts when storage turns something down. -->
    <string name="projects_problem_open">That project couldn’t be opened</string>
    <string name="projects_problem_create">There’s no room to save another project</string>
    <string name="projects_problem_rename">The new name couldn’t be saved</string>
    <string name="projects_problem_delete">That project couldn’t be deleted</string>
    <string name="projects_problem_restore">That project couldn’t be brought back</string>

    <!-- The banner over a theme opened from a link, until it is saved. -->
    <string name="share_transient">This theme came from a link and isn’t saved yet</string>
    <string name="share_transient_save">Save to my projects</string>

    <!-- The share dialog. -->
    <string name="share_title">Share this theme</string>
    <string name="share_body">Anyone with the link opens this theme as it is now.</string>
    <string name="share_link_label">Share link</string>
    <string name="share_copy">Copy link</string>
    <string name="share_send">Share</string>
    <string name="share_copied">Link copied</string>
    <string name="share_manual">That didn’t work. Select the link above and copy it yourself.</string>
    <string name="share_unavailable">This theme can’t be put in a link</string>

    <!-- Notices when a pasted link can't be opened. -->
    <string name="share_newer_version">Made with a newer version. Reload to update.</string>
    <string name="share_invalid">That link doesn’t open a theme</string>
