<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The wordmark at the top of the poster. -->
    <string name="poster_wordmark">MaterialKolor</string>
    <!-- The Projects button, when the session has not named a project yet. -->
    <string name="poster_projects">Projects</string>
    <!-- What the Projects button reads out while the latest changes are saved. The argument is the project's name. -->
    <string name="poster_projects_saved">Projects, %1$s, saved</string>
    <!-- What the Projects button reads out while a save is waiting or under way. The argument is the project's name. -->
    <string name="poster_projects_saving">Projects, %1$s, saving</string>
    <!-- What the Projects button reads out when the last save did not land. The argument is the project's name. -->
    <string name="poster_projects_not_saved">Projects, %1$s, not saved</string>
    <!-- The badge beside the Projects button when the last save did not land. -->
    <string name="poster_save_failed">Not saved</string>
    <!-- The header button that shrinks the poster to its rail. -->
    <string name="poster_collapse">Collapse the poster</string>
    <!-- The rail button that opens the poster again. -->
    <string name="poster_expand">Open the poster</string>

    <!-- The small label over the seed hex. -->
    <string name="poster_seed">Seed</string>
    <!-- The seed field's name, read out since the big hex shows no label. -->
    <string name="poster_seed_field">Seed color, any format</string>
    <!-- The seed field's name with where the seed came from after it. The first argument is poster_seed_field, the second one of the poster_source strings. -->
    <string name="poster_seed_field_source">%1$s. %2$s</string>
    <!-- The seed's hue, chroma and tone, each rounded, set in capitals like a spec sheet. -->
    <string name="poster_hct">HUE %1$d · CHROMA %2$d · TONE %3$d</string>
    <!-- The button that copies the seed as hex. -->
    <string name="poster_copy_hex">Copy hex</string>
    <!-- The button that copies the seed as a Compose color. -->
    <string name="poster_copy_kotlin">Copy Kotlin</string>
    <!-- Names the copy in the "Copied ..." toast. -->
    <string name="poster_copied_hex">seed hex</string>
    <!-- Names the copy in the "Copied ..." toast. -->
    <string name="poster_copied_kotlin">seed as Kotlin</string>

    <!-- Where the seed came from, read out after the seed field's name. -->
    <string name="poster_source_typed">Typed in</string>
    <string name="poster_source_picked">Picked in the color picker</string>
    <string name="poster_source_eyedropper">Picked with the eyedropper</string>
    <string name="poster_source_shuffled">Shuffled</string>
    <string name="poster_source_preset">From a preset</string>
    <string name="poster_source_image">From an image</string>
    <!-- The argument is the image's file name. -->
    <string name="poster_source_image_named">From %1$s</string>
    <!-- After the seed's readout when the seed came from an image with no file name. -->
    <string name="poster_readout_image">from an image</string>
    <!-- After the seed's readout when the seed came from an image. The argument is the image's file name. -->
    <string name="poster_readout_image_named">from %1$s</string>

    <!-- Under the seed field, about text that is not a color. -->
    <string name="poster_hex_empty">Type a color</string>
    <string name="poster_hex_bad_hex">Hex takes 3, 6 or 8 digits</string>
    <string name="poster_hex_bad_arguments">Those values do not make a color</string>
    <string name="poster_hex_unknown_function">Try hex, rgb(), hsl() or oklch()</string>
    <string name="poster_hex_unknown_name">That is not a CSS color name</string>
    <string name="poster_hex_unrecognized">That does not read as a color</string>
    <!-- Under the seed field, about what had to change to read the color. -->
    <string name="poster_note_alpha">A seed is always opaque, so the alpha was dropped</string>
    <string name="poster_note_clamped">Pulled back inside sRGB</string>
    <string name="poster_note_both">Alpha dropped and pulled back inside sRGB</string>

    <!-- The actions under the seed. -->
    <string name="poster_shuffle">Shuffle</string>
    <!-- The key that shuffles, shown beside the button. -->
    <string name="poster_space">Space</string>
    <string name="poster_pick">Pick</string>
    <string name="poster_image">Image</string>
    <!-- What a shuffle is told to leave alone. -->
    <string name="poster_lock_hue">Lock hue</string>
    <string name="poster_lock_style">Lock style</string>
    <string name="poster_lock_seed">Lock seed</string>
    <!-- Why Shuffle is off while the seed and the style are both locked, in its tooltip and the command palette. -->
    <string name="poster_all_locked">The seed and the style are both locked, so Shuffle has nothing to change</string>
    <!-- What the Shuffle button reads out while it is off. The argument is poster_all_locked. -->
    <string name="poster_shuffle_off">Shuffle. %1$s</string>

    <!-- The one hint on a first visit, a single line near the foot of the poster. The tests check it word for word. -->
    <string name="poster_first_run_hint">Paste a color or drop an image anywhere.</string>

    <!-- The seed swatch on the rail. The argument is the seed's hex. -->
    <string name="poster_rail_seed">Seed %1$s</string>
</resources>
