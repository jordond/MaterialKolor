    <string name="tabs_palette_primary">Primary</string>
    <!-- The Palettes tab heading over the secondary palette. -->
    <string name="tabs_palette_secondary">Secondary</string>
    <!-- The Palettes tab heading over the tertiary palette. -->
    <string name="tabs_palette_tertiary">Tertiary</string>
    <!-- The Palettes tab heading over the neutral palette. -->
    <string name="tabs_palette_neutral">Neutral</string>
    <!-- The Palettes tab heading over the neutral variant palette. -->
    <string name="tabs_palette_neutral_variant">Neutral variant</string>
    <!-- The Palettes tab heading over the error palette. -->
    <string name="tabs_palette_error">Error</string>
    <!-- A marker on a ramp shared by both modes, for the light scheme. %1$s is the role, such as primary. -->
    <string name="tabs_mark_light">%1$s light</string>
    <!-- A marker on a ramp shared by both modes, for the dark scheme. %1$s is the role, such as primary. -->
    <string name="tabs_mark_dark">%1$s dark</string>
    <!-- Names what was copied in the copy toast. %1$s is the ramp, such as Primary, and %2$d the tone of the stop. -->
    <string name="tabs_copied_tone">%1$s tone %2$d</string>
    <!-- The label on the ramp Show on ramp picked out. %1$s is the role or accent color, such as primary. -->
    <string name="tabs_ramp_shown">%1$s sits on this ramp</string>
    <!-- A Contrast tab row. %1$s is the color on top, %2$s the color under it, such as onPrimary on primary. -->
    <string name="tabs_pair">%1$s on %2$s</string>
    <!-- A contrast ratio. %1$s is the ratio to one decimal. -->
    <string name="tabs_ratio">%1$s to 1</string>
    <!-- Why a pair fails. Each name is the key of an audit reason. -->
    <string name="audit_reason_text_only_large">Under 4.5 to 1, so only large text reads well here.</string>
    <string name="audit_reason_text_unreadable">Under 3 to 1, so text is hard to read at any size.</string>
    <string name="audit_reason_shape_faint">Under 3 to 1, so borders and icons are hard to see.</string>
    <!-- What to try on a failing pair. Each name is the key of an audit suggestion. -->
    <string name="audit_suggest_change_pin">Try another pinned color, or unpin the role.</string>
    <string name="audit_suggest_move_accent_tones">Try pulling the accent’s tones apart or raising its threshold.</string>
    <string name="audit_suggest_move_slot_tone">Try moving the slot’s tone.</string>
    <string name="audit_suggest_change_seed">Try a lighter or darker seed. Fluent’s text colors are fixed.</string>
    <string name="audit_suggest_raise_contrast">Try a higher contrast level.</string>
</resources>
