    <string name="tabs_copy_hex">Copy hex</string>
    <!-- The swatch menu item that copies the color as a Kotlin Color literal. -->
    <string name="tabs_copy_kotlin">Copy Kotlin literal</string>
    <!-- Names what was copied in the copy toast. %1$s is the swatch name, such as primary. -->
    <string name="tabs_copied_hex">%1$s hex</string>
