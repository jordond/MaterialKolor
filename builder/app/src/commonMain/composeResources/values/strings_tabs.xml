    <string name="tabs_all_pass">Every pair passes AA at this contrast level</string>
    <!-- The Contrast tab note under a mode's heading when Failures only is on and nothing in that mode fails. -->
    <string name="tabs_mode_no_failures">Nothing fails in this mode</string>
