<resources>
    <!-- The Roles tab heading over the accent roles, error included. -->
    <string name="tabs_group_accent">Accent</string>
    <!-- The Roles tab heading over the background and surface roles. -->
    <string name="tabs_group_surface">Surface</string>
    <!-- The Roles tab heading over the fixed roles, which keep their tone in both modes. -->
    <string name="tabs_group_fixed">Fixed</string>
    <!-- The Roles tab heading over the outline, scrim and inverse roles. -->
    <string name="tabs_group_outline_inverse">Outline and inverse</string>
    <!-- The Roles tab heading over the key color each palette is built around. -->
    <string name="tabs_group_key_colors">Key colors</string>
    <!-- The Roles tab heading over the document's extra accents. -->
    <string name="tabs_group_accents">Accents</string>
