    <string name="palette_words_inspect">element, hover, what is this</string>
    <string name="palette_words_fullscreen">zen, maximize, hide the poster</string>
    <string name="palette_words_export">code, kotlin, files, download</string>
    <string name="palette_words_share">link, url, send</string>
    <string name="palette_words_projects">open, saved themes, load</string>
    <string name="palette_words_appearance">dark mode, light mode, chrome</string>
    <string name="palette_words_motion">animation, reduce motion</string>
    <string name="palette_words_vision">color blindness, colour blind, simulate</string>
    <string name="palette_words_device">size, phone, tablet, desktop, width</string>
    <string name="palette_words_keys">keyboard, hotkeys, accessibility</string>
    <string name="palette_words_accents">accents, custom colors</string>
    <string name="palette_words_pins">pins, pinned</string>
